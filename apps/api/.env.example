PORT=4000

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Also used to verify Supabase Auth access tokens for the /auth/* and
# /business/* routes (README §14) -- no separate auth-specific key needed,
# since token verification just calls the same project's Auth API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web push (BACKLOG.md Ref 89). Generate a pair with `npx web-push
# generate-vapid-keys`. VAPID_PUBLIC_KEY must match apps/web's
# NEXT_PUBLIC_VAPID_PUBLIC_KEY -- VAPID_PRIVATE_KEY stays server-side only,
# never exposed to the browser. VAPID_SUBJECT is a mailto: contact address
# push services may use to reach you about a misbehaving sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Geoapify Places/Geocoding API key (docs/geoapify-migration-plan.md) --
# powers neighborhood venue discovery/sync, admin boundary preview, the
# admin "investigate missing venue" lookup, and venue enrichment (hours,
# phone, website). Falls back to mock data (MockGeoapifyClient) when unset,
# e.g. local dev without a real key.
GEOAPIFY_API_KEY=
