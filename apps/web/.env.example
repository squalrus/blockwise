API_URL=http://localhost:4000

# Supabase project settings, browser-side half (Project Settings > API in the
# Supabase dashboard) -- used only for Supabase Auth (email/password
# signup/login, README §14). Must be NEXT_PUBLIC_ prefixed since read
# client-side; the anon key is meant to be exposed to the browser (RLS/Auth
# policy enforce what it can do, and it never touches app tables directly --
# see apps/web/src/lib/supabaseClient.ts).
# Local dev should point at the `spored-dev` project, not production --
# see docs/plans/20260905-dev-environment-plan.md and supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geoapify API key for the venues map view and admin boundary-drawing tool
# (MapLibre GL JS + Geoapify vector tiles, BACKLOG.md Ref 114 Phase 6).
# Reuses the same Geoapify project as the Places sync (see
# apps/api/.env.example's GEOAPIFY_API_KEY) -- create a browser-restricted
# key (HTTP referrer restriction) rather than reusing the server-side key
# directly. Must be NEXT_PUBLIC_ prefixed since it's read client-side.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# GA4 measurement ID for app.tryspored.com (Google Analytics dashboard >
# Admin > Data streams). Separate property/stream from apps/marketing's
# NEXT_PUBLIC_GA_MEASUREMENT_ID -- this one tracks authenticated in-app
# usage, not marketing-site traffic. GoogleAnalytics is a no-op when unset
# (see src/app/layout.tsx), so this can be left blank in local dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web push (BACKLOG.md Ref 89). Must match apps/api's VAPID_PUBLIC_KEY --
# only the public half belongs here; NEXT_PUBLIC_ exposes it to the browser
# bundle, which is fine since it's not secret (pushManager.subscribe() needs
# it client-side to create a subscription).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
