{
  "name": "blockwise",
  "version": "0.79.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "node -e \"require('fs').rmSync('.turbo',{recursive:true,force:true});for(const d of ['apps','packages'])for(const p of require('fs').readdirSync(d))require('fs').rmSync(`${d}/${p}/.turbo`,{recursive:true,force:true})\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.9.0"
}
